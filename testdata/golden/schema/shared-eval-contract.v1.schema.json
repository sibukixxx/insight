{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techvit.example/contracts/shared-eval-contract.v1.schema.json",
  "title": "TechVit Shared Eval Contract v1",
  "type": "object",
  "required": ["schemaVersion", "caseId", "input", "expected", "outcome"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "caseId": {"type": "string", "minLength": 1},
    "domain": {"type": "string"},
    "input": {
      "type": "object",
      "required": ["references"],
      "properties": {
        "references": {"type": "array", "items": {"type": "string"}},
        "contextReferences": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "expected": {
      "type": "object",
      "properties": {
        "properties": {"type": "array", "items": {"type": "string"}},
        "requiredEvidence": {"type": "array", "items": {"type": "string"}},
        "prohibitedClaims": {"type": "array", "items": {"type": "string"}},
        "schemaChecks": {"type": "array", "items": {"type": "string"}},
        "qualityChecks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "calibration": {
      "type": "object",
      "properties": {
        "confidenceField": {"type": "string"},
        "meaning": {"type": "string"}
      },
      "additionalProperties": true
    },
    "performance": {
      "type": "object",
      "properties": {
        "latencyMs": {"type": "number", "minimum": 0},
        "cost": {"type": "number", "minimum": 0},
        "unit": {"type": "string"}
      },
      "additionalProperties": true
    },
    "humanReview": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "reviewer": {"type": "string"},
        "result": {"enum": ["PASS", "FAIL", "PARTIAL", "NOT_REVIEWED"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "PARTIAL"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
