{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sibukixxx/insight/contracts/public-engine/v1/schema.json",
  "title": "Insight Lab Public Engine Contract v1",
  "description": "Language-neutral, domain-neutral request and result messages exchanged over HTTP/JSON under /api/public/v1. This file is the single source of truth: the server, the Go SDK and the TypeScript SDK are checked against its $defs. A subject namespace or type is opaque metadata and never changes engine behavior.",
  "x-contractSchema": "insight-lab.public-engine",
  "x-contractVersion": "1",
  "x-operations": {
    "getEngine": {"method": "GET", "path": "/api/public/v1/engine", "response": "EngineInfo", "status": 200},
    "createSubject": {"method": "POST", "path": "/api/public/v1/subjects", "request": "CreateSubjectRequest", "response": "Subject", "status": 201},
    "addEvidence": {"method": "POST", "path": "/api/public/v1/subjects/{subjectId}/evidence", "request": "AddEvidenceRequest", "response": "EvidenceReceipt", "status": 200},
    "startAnalysis": {"method": "POST", "path": "/api/public/v1/subjects/{subjectId}/analyses", "request": "StartAnalysisRequest", "response": "AnalysisRun", "status": 202},
    "getAnalysis": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/analyses/{analysisId}", "response": "AnalysisRun", "status": 200},
    "getAnalysisResults": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/analyses/{analysisId}/results", "response": "AnalysisResults", "status": 200},
    "createResearchRun": {"method": "POST", "path": "/api/public/v1/subjects/{subjectId}/research-runs", "request": "CreateResearchRunRequest", "response": "ResearchResult", "status": 201},
    "appendIteration": {"method": "POST", "path": "/api/public/v1/research-runs/{researchRunId}/iterations", "request": "AppendIterationRequest", "response": "ResearchResult", "status": 201},
    "getResearchRun": {"method": "GET", "path": "/api/public/v1/research-runs/{researchRunId}", "response": "ResearchResult", "status": 200},
    "createDatasetProfile": {"method": "POST", "path": "/api/public/v1/subjects/{subjectId}/dataset-profiles", "request": "CreateDatasetProfileRequest", "response": "DatasetProfile", "status": 201},
    "getDatasetProfile": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/dataset-profiles/{profileId}", "response": "DatasetProfile", "status": 200},
    "triage": {"method": "POST", "path": "/api/public/v1/subjects/{subjectId}/dataset-profiles/{profileId}/triage", "request": "TriageRequest", "response": "SelectionPlan", "status": 201},
    "listSelectionPlans": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/dataset-profiles/{profileId}/selection-plans", "response": "SelectionPlanList", "status": 200},
    "getSelectionPlan": {"method": "GET", "path": "/api/public/v1/selection-plans/{planId}", "response": "SelectionPlan", "status": 200},
    "reviseSelectionPlan": {"method": "POST", "path": "/api/public/v1/selection-plans/{planId}/revisions", "request": "ReviseSelectionPlanRequest", "response": "SelectionPlan", "status": 201},
    "listAnalyses": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/analyses", "response": "AnalysisList", "status": 200},
    "compareAnalyses": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/analyses/{analysisId}/compare/{otherAnalysisId}", "response": "RunComparisonResult", "status": 200},
    "listResearchRuns": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/research-runs", "response": "ResearchRunList", "status": 200},
    "reEvaluate": {"method": "POST", "path": "/api/public/v1/research-runs/{researchRunId}/re-evaluations", "request": "ReEvaluationRequest", "response": "ReEvaluationResult", "status": 201}
  },
  "x-errorCodes": {
    "INVALID_REQUEST": 400,
    "UNSUPPORTED_CONTRACT_VERSION": 400,
    "NOT_FOUND": 404,
    "IDEMPOTENCY_CONFLICT": 409,
    "IDENTITY_CONFLICT": 409,
    "ANALYSIS_NOT_COMPLETED": 409,
    "ANALYSIS_HAS_NO_HYPOTHESES": 409,
    "MIXED_ANALYSIS_RUNS": 409,
    "STALE_ITERATION": 409,
    "INTERNAL": 500
  },
  "x-limits": {
    "maxRequestBytes": 16777216,
    "maxMetadataEntries": 32,
    "maxMetadataKeyLength": 64,
    "maxMetadataValueLength": 1024,
    "maxDocumentsPerRequest": 500,
    "maxDocumentContentLength": 200000,
    "maxArtifactsPerRequest": 50,
    "maxQuestionLength": 2000
  },
  "$defs": {
    "ContractVersion": {"type": "string", "const": "1"},
    "IdempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "Metadata": {
      "type": "object",
      "description": "Bounded opaque string metadata. Keys match ^[A-Za-z0-9._:-]{1,64}$. In document metadata, keys starting with public_ or analytical_ and the keys dataset_hash and acquisition_manifest are reserved: the engine records that provenance itself.",
      "maxProperties": 32,
      "additionalProperties": {"type": "string", "maxLength": 1024}
    },
    "SubjectRef": {
      "type": "object",
      "description": "Opaque external subject. Insight stores and echoes it but never interprets or branches on it.",
      "required": ["namespace", "id"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "type": {"type": "string", "maxLength": 128}
      }
    },
    "EngineBuild": {
      "type": "object",
      "required": ["version", "commit", "dirty"],
      "properties": {
        "version": {"type": "string", "description": "Release version, or UNKNOWN."},
        "commit": {"type": "string", "description": "Git commit, or UNKNOWN."},
        "dirty": {"type": "string", "enum": ["true", "false", "UNKNOWN"]}
      }
    },
    "SchemaRef": {
      "type": "object",
      "required": ["schema", "version"],
      "properties": {"schema": {"type": "string"}, "version": {"type": "string"}}
    },
    "EngineInfo": {
      "type": "object",
      "required": ["contractSchema", "contractVersion", "supportedContractVersions", "engine", "researchArtifact", "analyticalArtifact"],
      "properties": {
        "contractSchema": {"type": "string", "const": "insight-lab.public-engine"},
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "supportedContractVersions": {"type": "array", "items": {"type": "string"}},
        "engine": {"$ref": "#/$defs/EngineBuild"},
        "researchArtifact": {"$ref": "#/$defs/SchemaRef"},
        "analyticalArtifact": {"$ref": "#/$defs/SchemaRef"}
      }
    },
    "CreateSubjectRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey", "subject"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "subject": {"$ref": "#/$defs/SubjectRef"},
        "title": {"type": "string", "maxLength": 256},
        "metadata": {"$ref": "#/$defs/Metadata"}
      }
    },
    "Subject": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "subject", "title", "createdAt"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "subject": {"$ref": "#/$defs/SubjectRef"},
        "title": {"type": "string"},
        "metadata": {"$ref": "#/$defs/Metadata"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "EvidenceDocument": {
      "type": "object",
      "required": ["externalRef", "source", "content"],
      "properties": {
        "externalRef": {"type": "string", "minLength": 1, "maxLength": 256, "description": "Caller's stable reference, unique within a subject."},
        "source": {"type": "string", "enum": ["interview", "review", "support", "sales", "survey", "job_posting", "social_post", "dataset"]},
        "title": {"type": "string", "maxLength": 512},
        "content": {"type": "string", "minLength": 1, "maxLength": 200000},
        "metadata": {"$ref": "#/$defs/Metadata"}
      }
    },
    "AddEvidenceRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey"],
      "description": "At least one document or analytical artifact is required. Artifacts follow contracts/analytical-artifact/v1/schema.json.",
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "documents": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/EvidenceDocument"}},
        "analyticalArtifacts": {"type": "array", "maxItems": 50, "items": {"type": "object"}}
      }
    },
    "EvidenceItemReceipt": {
      "type": "object",
      "required": ["documentId", "status"],
      "properties": {
        "externalRef": {"type": "string"},
        "artifactId": {"type": "string"},
        "reproducibilityKey": {"type": "string"},
        "documentId": {"type": "string"},
        "status": {"type": "string", "enum": ["CREATED", "UNCHANGED"]}
      }
    },
    "EvidenceReceipt": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "documents", "analyticalArtifacts"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/EvidenceItemReceipt"}},
        "analyticalArtifacts": {"type": "array", "items": {"$ref": "#/$defs/EvidenceItemReceipt"}}
      }
    },
    "StartAnalysisRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "label": {"type": "string", "maxLength": 256},
        "note": {"type": "string", "maxLength": 2000},
        "semanticAnalysisMode": {"type": "string", "enum": ["DISCOVERY", "DATASET_ANALYSIS", "RESEARCH_REVIEW"]}
      }
    },
    "AnalysisProvenance": {
      "type": "object",
      "description": "The run's execution and input snapshots, verbatim. A snapshot the run never recorded is omitted, never sent empty.",
      "properties": {
        "execution": {"type": "object"},
        "input": {"type": "object"}
      }
    },
    "AnalysisRun": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "analysisId", "status", "createdAt"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "analysisId": {"type": "string"},
        "status": {"type": "string", "enum": ["queued", "running", "completed", "failed"]},
        "error": {"type": "string"},
        "label": {"type": "string"},
        "note": {"type": "string"},
        "semanticAnalysisMode": {"type": "string"},
        "executionMode": {"type": "string", "enum": ["deterministic", "model_backed"]},
        "engine": {"$ref": "#/$defs/EngineBuild"},
        "executionFingerprint": {"type": "string"},
        "inputFingerprint": {"type": "string"},
        "provenance": {"$ref": "#/$defs/AnalysisProvenance"},
        "createdAt": {"type": "string", "format": "date-time"},
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "Observation": {
      "type": "object",
      "required": ["observationId", "documentId", "quote", "startOffset", "endOffset", "behavior"],
      "properties": {
        "observationId": {"type": "string"},
        "documentId": {"type": "string"},
        "externalRef": {"type": "string"},
        "quote": {"type": "string", "description": "Exact text of the source document between startOffset and endOffset (rune offsets)."},
        "startOffset": {"type": "integer"},
        "endOffset": {"type": "integer"},
        "behavior": {"type": "string"},
        "topic": {"type": "string"}
      }
    },
    "Finding": {
      "type": "object",
      "required": ["findingId", "kind", "title", "observationIds"],
      "properties": {
        "findingId": {"type": "string"},
        "kind": {"type": "string", "enum": ["repetition", "deviation"]},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "expectation": {"type": "string"},
        "observationIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "AnalysisResults": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "analysisId", "observations", "findings"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "analysisId": {"type": "string"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/Observation"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/Finding"}},
        "metrics": {"type": "object", "description": "The run's recorded evaluation metrics, verbatim."}
      }
    },
    "CreateResearchRunRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey", "question", "analysisId"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "analysisId": {"type": "string", "minLength": 1},
        "inputReferences": {"type": "array", "items": {"type": "string"}},
        "semanticAnalysisMode": {"type": "string", "enum": ["DISCOVERY", "DATASET_ANALYSIS", "RESEARCH_REVIEW"]}
      }
    },
    "AddedEvidenceLink": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "gapIds": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "AppendIterationRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey", "analysisId"],
      "description": "Appends a new iteration evaluated on a completed analysis run. Earlier iterations are never modified.",
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "analysisId": {"type": "string", "minLength": 1},
        "question": {"type": "string", "maxLength": 2000},
        "addedEvidence": {"type": "array", "items": {"$ref": "#/$defs/AddedEvidenceLink"}}
      }
    },
    "ResearchResult": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "researchRunId", "iterationId", "iterationSequence", "analysis", "artifact"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "researchRunId": {"type": "string"},
        "iterationId": {"type": "string"},
        "iterationSequence": {"type": "integer"},
        "analysis": {"$ref": "#/$defs/AnalysisRun"},
        "artifact": {"type": "object", "description": "The insight-lab.research-artifact v1 export of the latest iteration, verbatim. Its legacy analysisMode key means execution mode."}
      }
    },
    "AnalysisList": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "analyses"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "analyses": {"type": "array", "items": {"$ref": "#/$defs/AnalysisRun"}, "description": "Every analysis run of the subject, oldest first."}
      }
    },
    "RunComparisonResult": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "comparison"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "comparison": {"$ref": "#/$defs/RunComparison"}
      }
    },
    "RunComparison": {
      "type": "object",
      "description": "Non-persistent comparison of two analysis runs of one subject (#83). It attributes a result delta to the input or execution axis. It never judges which run is better and never claims a cause.",
      "required": ["from", "to", "input", "execution", "attribution", "repeatGroups", "metrics", "insights", "explanation"],
      "properties": {
        "from": {"$ref": "#/$defs/RunRef"},
        "to": {"$ref": "#/$defs/RunRef"},
        "input": {"$ref": "#/$defs/InputAxisDiff"},
        "execution": {"$ref": "#/$defs/ExecutionAxisDiff"},
        "attribution": {"type": "string", "enum": ["SAME_CONFIGURATION", "EXECUTION_CHANGE", "INPUT_CHANGE", "CONFOUNDED", "ATTRIBUTION_UNAVAILABLE"]},
        "repeatGroups": {"type": "array", "items": {"$ref": "#/$defs/RepeatGroup"}},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/MetricDelta"}},
        "insights": {"$ref": "#/$defs/InsightResultDiff"},
        "explanation": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "The first entry always states that differences are not evidence of cause."}
      }
    },
    "RunRef": {
      "type": "object",
      "required": ["analysisId", "status", "createdAt"],
      "properties": {
        "analysisId": {"type": "string"},
        "status": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"},
        "inputFingerprint": {"type": "string", "description": "Absent when not recorded; never read as the same as another run."},
        "executionFingerprint": {"type": "string", "description": "Absent when not recorded; never read as the same as another run."}
      }
    },
    "AxisState": {"type": "string", "enum": ["SAME", "CHANGED", "UNKNOWN"]},
    "FieldChange": {
      "type": "object",
      "required": ["field", "from", "to"],
      "properties": {
        "field": {"type": "string"},
        "from": {"type": "string", "description": "Empty when the field was absent."},
        "to": {"type": "string", "description": "Empty when the field was absent."}
      }
    },
    "ExecutionAxisDiff": {
      "type": "object",
      "required": ["state", "changes"],
      "properties": {
        "state": {"$ref": "#/$defs/AxisState"},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/FieldChange"}, "description": "Field-level diff: engineVersion, gitCommit, gitDirty, executionMode, semanticAnalysisMode, ruleVersions.*, promptVersion, promptFingerprint, provider, models.*, parameters."}
      }
    },
    "InputAxisDiff": {
      "type": "object",
      "required": ["state", "documentsAdded", "documentsRemoved", "datasetHashesAdded", "datasetHashesRemoved", "datasetsAdded", "datasetsRemoved"],
      "properties": {
        "state": {"$ref": "#/$defs/AxisState"},
        "documentsAdded": {"type": "array", "items": {"type": "string"}, "description": "source:contentHash:metadataHash identities."},
        "documentsRemoved": {"type": "array", "items": {"type": "string"}},
        "datasetHashesAdded": {"type": "array", "items": {"type": "string"}},
        "datasetHashesRemoved": {"type": "array", "items": {"type": "string"}},
        "datasetsAdded": {"type": "array", "items": {"type": "string"}, "description": "datasetId@schemaVersion:fileHash identities."},
        "datasetsRemoved": {"type": "array", "items": {"type": "string"}}
      }
    },
    "MetricDelta": {
      "type": "object",
      "required": ["metric", "from", "to", "delta"],
      "properties": {
        "metric": {"type": "string"},
        "from": {"type": ["number", "null"]},
        "to": {"type": ["number", "null"]},
        "delta": {"type": ["number", "null"], "description": "Null unless both runs recorded the metric."}
      }
    },
    "InsightMatch": {
      "type": "object",
      "required": ["fromInsightId", "toInsightId", "method", "score", "changes"],
      "properties": {
        "fromInsightId": {"type": "string"},
        "toInsightId": {"type": "string"},
        "method": {"type": "string", "enum": ["EXACT_EVIDENCE_SPANS", "EVIDENCE_SPAN_OVERLAP", "HYPOTHESIS_COMPARISON_KEY"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/FieldChange"}}
      }
    },
    "InsightResultDiff": {
      "type": "object",
      "required": ["added", "removed", "matched"],
      "properties": {
        "added": {"type": "array", "items": {"type": "string"}},
        "removed": {"type": "array", "items": {"type": "string"}},
        "matched": {"type": "array", "items": {"$ref": "#/$defs/InsightMatch"}}
      }
    },
    "MetricRange": {
      "type": "object",
      "required": ["metric", "min", "max"],
      "properties": {
        "metric": {"type": "string"},
        "min": {"type": "number"},
        "max": {"type": "number"}
      }
    },
    "RepeatGroup": {
      "type": "object",
      "required": ["key", "analysisIds", "runs", "variationKnown", "metrics"],
      "properties": {
        "key": {"type": "string", "description": "inputFingerprint|executionFingerprint."},
        "analysisIds": {"type": "array", "items": {"type": "string"}},
        "runs": {"type": "integer"},
        "variationKnown": {"type": "boolean", "description": "False for a single run: variation is unknown, not zero."},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/MetricRange"}}
      }
    },
    "ResearchRunSummary": {
      "type": "object",
      "required": ["researchRunId", "question", "iterationCount", "latestIterationId", "latestIterationSequence", "createdAt"],
      "properties": {
        "researchRunId": {"type": "string"},
        "question": {"type": "string"},
        "iterationCount": {"type": "integer"},
        "latestIterationId": {"type": "string"},
        "latestIterationSequence": {"type": "integer"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "ResearchRunList": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "researchRuns"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "researchRuns": {"type": "array", "items": {"$ref": "#/$defs/ResearchRunSummary"}}
      }
    },
    "ReEvaluationTrigger": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["MANUAL", "SCHEDULED"]},
        "source": {"type": "string", "maxLength": 128, "description": "Opaque name of the scheduler or person; never interpreted."}
      }
    },
    "EvidenceChanges": {
      "type": "object",
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": {"type": "array", "items": {"type": "string"}, "maxItems": 500},
        "removed": {"type": "array", "items": {"type": "string"}, "maxItems": 500},
        "changed": {"type": "array", "items": {"type": "string"}, "maxItems": 500}
      }
    },
    "ReEvaluationRequest": {
      "type": "object",
      "description": "Re-evaluate a research run because new evidence arrived (#74). analysisId names a completed analysis run over the new evidence. The engine schedules nothing itself.",
      "required": ["contractVersion", "idempotencyKey", "correlationKey", "previousIterationId", "analysisId", "trigger", "evidenceChanges"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "correlationKey": {"type": "string", "minLength": 1, "maxLength": 128, "description": "Caller correlation id. Reusing it with the same analysisId returns ALREADY_EVALUATED; with another analysisId it is IDEMPOTENCY_CONFLICT."},
        "previousIterationId": {"type": "string", "description": "Must be the latest iteration, otherwise STALE_ITERATION."},
        "analysisId": {"type": "string"},
        "trigger": {"$ref": "#/$defs/ReEvaluationTrigger"},
        "evidenceChanges": {"$ref": "#/$defs/EvidenceChanges"},
        "affectedGapIds": {"type": "array", "items": {"type": "string"}, "maxItems": 500},
        "note": {"type": "string", "maxLength": 2000}
      }
    },
    "ReEvaluationRecord": {
      "type": "object",
      "description": "Audit record attached to the iteration a re-evaluation created. Earlier iterations are never modified.",
      "required": ["correlationKey", "previousIterationId", "trigger", "evidenceChanges", "affectedGapIds", "affectedHypothesisIds", "scope", "scopeReason", "recordedAt"],
      "properties": {
        "correlationKey": {"type": "string"},
        "previousIterationId": {"type": "string"},
        "trigger": {"$ref": "#/$defs/ReEvaluationTrigger"},
        "evidenceChanges": {"$ref": "#/$defs/EvidenceChanges"},
        "affectedGapIds": {"type": "array", "items": {"type": "string"}},
        "affectedHypothesisIds": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": "string", "enum": ["FULL"], "description": "Partial re-evaluation is not yet proven safe, so the whole iteration is re-evaluated."},
        "scopeReason": {"type": "string"},
        "inputFingerprintBefore": {"type": "string"},
        "inputFingerprintAfter": {"type": "string"},
        "executionFingerprintBefore": {"type": "string"},
        "executionFingerprintAfter": {"type": "string"},
        "note": {"type": "string"},
        "recordedAt": {"type": "string", "format": "date-time"}
      }
    },
    "ReEvaluationResult": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "researchRunId", "status", "reEvaluation", "result"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "researchRunId": {"type": "string"},
        "status": {"type": "string", "enum": ["NEW_ITERATION", "NO_EVIDENCE_CHANGE", "ALREADY_EVALUATED"], "description": "NEW_ITERATION returns 201; the others return 200 and append nothing."},
        "reEvaluation": {"$ref": "#/$defs/ReEvaluationRecord"},
        "result": {"$ref": "#/$defs/ResearchResult"}
      }
    },
    "ErrorBody": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "enum": ["INVALID_REQUEST", "UNSUPPORTED_CONTRACT_VERSION", "NOT_FOUND", "IDEMPOTENCY_CONFLICT", "IDENTITY_CONFLICT", "ANALYSIS_NOT_COMPLETED", "ANALYSIS_HAS_NO_HYPOTHESES", "MIXED_ANALYSIS_RUNS", "STALE_ITERATION", "INTERNAL"]},
        "message": {"type": "string"}
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["contractVersion", "error"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "error": {"$ref": "#/$defs/ErrorBody"}
      }
    },
    "TriageBucket": {"type": "string", "enum": ["INCLUDE", "DEFER", "NEEDS_REVIEW", "EXCLUDE"], "description": "INCLUDE: deterministic processing should compute with the variable. DEFER: kept for later. NEEDS_REVIEW: definition or relevance unclear (UNKNOWN is preserved). EXCLUDE: a human chose not to process it; only HUMAN revisions may exclude and exclusion never deletes source data."},
    "TriageRole": {"type": "string", "enum": ["METRIC", "DIMENSION", "PERIOD", "IDENTIFIER"]},
    "TriageClassification": {"type": "string", "enum": ["POSSIBLE_OUTCOME", "POSSIBLE_EXPOSURE", "POSSIBLE_CONFOUNDER", "POSSIBLE_MEDIATOR", "POSSIBLE_COLLIDER", "COMPARISON_CANDIDATE", "DEFINITION_UNKNOWN"], "description": "Candidate research roles. Hypotheses about a variable, never causal findings."},
    "DatasetRef": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"type": "string", "description": "sha256:<hex> of the profiled bytes. When sent it must match; responses always carry the engine-computed value."}}},
    "CreateDatasetProfileRequest": {"type": "object", "description": "Exactly one of csv (inline, at most 8 MiB) or documentId (an evidence document of the subject) is required.", "required": ["contractVersion", "idempotencyKey", "dataset"], "properties": {"contractVersion": {"$ref": "#/$defs/ContractVersion"}, "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"}, "dataset": {"$ref": "#/$defs/DatasetRef"}, "csv": {"type": "string"}, "documentId": {"type": "string"}}},
    "ColumnProfile": {"type": "object", "required": ["name", "type", "nonNullCount", "nullCount", "distinctCount", "distinctCapped", "sampleValues"], "properties": {"name": {"type": "string"}, "type": {"type": "string", "enum": ["INTEGER", "NUMBER", "BOOLEAN", "DATE", "STRING", "EMPTY"]}, "nonNullCount": {"type": "integer"}, "nullCount": {"type": "integer"}, "distinctCount": {"type": "integer", "description": "Stops counting at 10000 (distinctCapped)."}, "distinctCapped": {"type": "boolean"}, "min": {"type": "string"}, "max": {"type": "string"}, "sampleValues": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 64}}}},
    "DatasetProfile": {"type": "object", "description": "Deterministic, bounded metadata. Identical bytes give an identical profileFingerprint. Raw rows are never stored or returned.", "required": ["contractVersion", "subjectId", "profileId", "dataset", "contentSha256", "rowCount", "columns", "profilerVersion", "profileFingerprint", "createdAt"], "properties": {"contractVersion": {"$ref": "#/$defs/ContractVersion"}, "subjectId": {"type": "string"}, "profileId": {"type": "string"}, "dataset": {"$ref": "#/$defs/DatasetRef"}, "documentId": {"type": "string"}, "contentSha256": {"type": "string"}, "rowCount": {"type": "integer"}, "columns": {"type": "array", "items": {"$ref": "#/$defs/ColumnProfile"}}, "profilerVersion": {"type": "string"}, "profileFingerprint": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}}},
    "TriageGapRef": {"type": "object", "required": ["gapId", "need"], "properties": {"gapId": {"type": "string", "minLength": 1, "maxLength": 128}, "need": {"type": "string", "maxLength": 2000}, "requiredDimensions": {"type": "array", "items": {"type": "string"}}}},
    "TriageRequest": {"type": "object", "description": "researchRunId adds the unresolved ResearchGaps and DataRequirements of that run's latest iteration to gaps (re-triage).", "required": ["contractVersion", "idempotencyKey", "question"], "properties": {"contractVersion": {"$ref": "#/$defs/ContractVersion"}, "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"}, "question": {"type": "string", "minLength": 1, "maxLength": 2000}, "triager": {"type": "string", "enum": ["DETERMINISTIC", "MODEL"], "description": "Default DETERMINISTIC. MODEL requires a configured model; its output passes the same normalization."}, "hypothesisIds": {"type": "array", "maxItems": 100, "items": {"type": "string"}}, "gaps": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/TriageGapRef"}}, "researchRunId": {"type": "string"}}},
    "PlanProposer": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "enum": ["DETERMINISTIC", "MODEL", "HUMAN"]}, "actor": {"type": "string"}, "model": {"type": "string"}}},
    "VariableDecision": {"type": "object", "required": ["name", "bucket", "rationale"], "properties": {"name": {"type": "string"}, "bucket": {"$ref": "#/$defs/TriageBucket"}, "role": {"$ref": "#/$defs/TriageRole"}, "classifications": {"type": "array", "items": {"$ref": "#/$defs/TriageClassification"}}, "rationale": {"type": "string", "minLength": 1}, "linkedGapIds": {"type": "array", "items": {"type": "string"}}}},
    "PlanMove": {"type": "object", "required": ["name", "toBucket", "rationale"], "properties": {"name": {"type": "string"}, "fromBucket": {"$ref": "#/$defs/TriageBucket"}, "toBucket": {"$ref": "#/$defs/TriageBucket"}, "role": {"$ref": "#/$defs/TriageRole"}, "classifications": {"type": "array", "items": {"$ref": "#/$defs/TriageClassification"}}, "rationale": {"type": "string", "minLength": 1}}},
    "SelectionPlan": {"type": "object", "description": "One immutable version. decisions lists every profiled column exactly once, in profile order. moves records how this version differs from its parent.", "required": ["contractVersion", "subjectId", "planId", "profileId", "version", "question", "proposer", "decisions", "processingBoundary", "createdAt"], "properties": {"contractVersion": {"$ref": "#/$defs/ContractVersion"}, "subjectId": {"type": "string"}, "planId": {"type": "string"}, "profileId": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "parentPlanId": {"type": "string"}, "question": {"type": "string"}, "proposer": {"$ref": "#/$defs/PlanProposer"}, "hypothesisIds": {"type": "array", "items": {"type": "string"}}, "gaps": {"type": "array", "items": {"$ref": "#/$defs/TriageGapRef"}}, "decisions": {"type": "array", "items": {"$ref": "#/$defs/VariableDecision"}}, "moves": {"type": "array", "items": {"$ref": "#/$defs/PlanMove"}}, "processingBoundary": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}}},
    "SelectionPlanList": {"type": "object", "required": ["contractVersion", "subjectId", "profileId", "plans"], "properties": {"contractVersion": {"$ref": "#/$defs/ContractVersion"}, "subjectId": {"type": "string"}, "profileId": {"type": "string"}, "plans": {"type": "array", "items": {"$ref": "#/$defs/SelectionPlan"}}}},
    "ReviseSelectionPlanRequest": {"type": "object", "required": ["contractVersion", "idempotencyKey", "actor", "moves"], "properties": {"contractVersion": {"$ref": "#/$defs/ContractVersion"}, "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"}, "actor": {"type": "string", "minLength": 1, "maxLength": 128}, "moves": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/PlanMove"}}}}
  }
}
