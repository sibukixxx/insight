{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sibukixxx/insight/contracts/public-engine/v1/schema.json",
  "title": "Insight Lab Public Engine Contract v1",
  "description": "Language-neutral, domain-neutral request and result messages exchanged over HTTP/JSON under /api/public/v1. This file is the single source of truth: the server, the Go SDK and the TypeScript SDK are checked against its $defs. A subject namespace or type is opaque metadata and never changes engine behavior.",
  "x-contractSchema": "insight-lab.public-engine",
  "x-contractVersion": "1",
  "x-operations": {
    "getEngine": {"method": "GET", "path": "/api/public/v1/engine", "response": "EngineInfo", "status": 200},
    "createSubject": {"method": "POST", "path": "/api/public/v1/subjects", "request": "CreateSubjectRequest", "response": "Subject", "status": 201},
    "addEvidence": {"method": "POST", "path": "/api/public/v1/subjects/{subjectId}/evidence", "request": "AddEvidenceRequest", "response": "EvidenceReceipt", "status": 200},
    "startAnalysis": {"method": "POST", "path": "/api/public/v1/subjects/{subjectId}/analyses", "request": "StartAnalysisRequest", "response": "AnalysisRun", "status": 202},
    "getAnalysis": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/analyses/{analysisId}", "response": "AnalysisRun", "status": 200},
    "getAnalysisResults": {"method": "GET", "path": "/api/public/v1/subjects/{subjectId}/analyses/{analysisId}/results", "response": "AnalysisResults", "status": 200},
    "createResearchRun": {"method": "POST", "path": "/api/public/v1/subjects/{subjectId}/research-runs", "request": "CreateResearchRunRequest", "response": "ResearchResult", "status": 201},
    "appendIteration": {"method": "POST", "path": "/api/public/v1/research-runs/{researchRunId}/iterations", "request": "AppendIterationRequest", "response": "ResearchResult", "status": 201},
    "getResearchRun": {"method": "GET", "path": "/api/public/v1/research-runs/{researchRunId}", "response": "ResearchResult", "status": 200},
    "getScenarios": {"method": "GET", "path": "/api/public/v1/research-runs/{researchRunId}/scenarios", "response": "ScenarioAnalysis", "status": 200},
    "createScenarioSet": {"method": "POST", "path": "/api/public/v1/research-runs/{researchRunId}/scenario-sets", "request": "CreateScenarioSetRequest", "response": "ScenarioSetResult", "status": 201},
    "scaffoldScenarioSet": {"method": "POST", "path": "/api/public/v1/research-runs/{researchRunId}/scenario-sets/scaffold", "request": "ScaffoldScenarioSetRequest", "response": "ScenarioSetResult", "status": 201},
    "evaluateScenarios": {"method": "POST", "path": "/api/public/v1/research-runs/{researchRunId}/scenario-sets/{scenarioSetId}/evaluations", "request": "EvaluateScenariosRequest", "response": "ScenarioEvaluationResult", "status": 201}
  },
  "x-errorCodes": {
    "INVALID_REQUEST": 400,
    "UNSUPPORTED_CONTRACT_VERSION": 400,
    "NOT_FOUND": 404,
    "IDEMPOTENCY_CONFLICT": 409,
    "IDENTITY_CONFLICT": 409,
    "ANALYSIS_NOT_COMPLETED": 409,
    "ANALYSIS_HAS_NO_HYPOTHESES": 409,
    "MIXED_ANALYSIS_RUNS": 409,
    "INTERNAL": 500
  },
  "x-limits": {
    "maxRequestBytes": 16777216,
    "maxMetadataEntries": 32,
    "maxMetadataKeyLength": 64,
    "maxMetadataValueLength": 1024,
    "maxDocumentsPerRequest": 500,
    "maxDocumentContentLength": 200000,
    "maxArtifactsPerRequest": 50,
    "maxQuestionLength": 2000
  },
  "$defs": {
    "ContractVersion": {"type": "string", "const": "1"},
    "IdempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "Metadata": {
      "type": "object",
      "description": "Bounded opaque string metadata. Keys match ^[A-Za-z0-9._:-]{1,64}$. In document metadata, keys starting with public_ or analytical_ and the keys dataset_hash and acquisition_manifest are reserved: the engine records that provenance itself.",
      "maxProperties": 32,
      "additionalProperties": {"type": "string", "maxLength": 1024}
    },
    "SubjectRef": {
      "type": "object",
      "description": "Opaque external subject. Insight stores and echoes it but never interprets or branches on it.",
      "required": ["namespace", "id"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "type": {"type": "string", "maxLength": 128}
      }
    },
    "EngineBuild": {
      "type": "object",
      "required": ["version", "commit", "dirty"],
      "properties": {
        "version": {"type": "string", "description": "Release version, or UNKNOWN."},
        "commit": {"type": "string", "description": "Git commit, or UNKNOWN."},
        "dirty": {"type": "string", "enum": ["true", "false", "UNKNOWN"]}
      }
    },
    "SchemaRef": {
      "type": "object",
      "required": ["schema", "version"],
      "properties": {"schema": {"type": "string"}, "version": {"type": "string"}}
    },
    "EngineInfo": {
      "type": "object",
      "required": ["contractSchema", "contractVersion", "supportedContractVersions", "engine", "researchArtifact", "analyticalArtifact"],
      "properties": {
        "contractSchema": {"type": "string", "const": "insight-lab.public-engine"},
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "supportedContractVersions": {"type": "array", "items": {"type": "string"}},
        "engine": {"$ref": "#/$defs/EngineBuild"},
        "researchArtifact": {"$ref": "#/$defs/SchemaRef"},
        "analyticalArtifact": {"$ref": "#/$defs/SchemaRef"}
      }
    },
    "CreateSubjectRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey", "subject"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "subject": {"$ref": "#/$defs/SubjectRef"},
        "title": {"type": "string", "maxLength": 256},
        "metadata": {"$ref": "#/$defs/Metadata"}
      }
    },
    "Subject": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "subject", "title", "createdAt"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "subject": {"$ref": "#/$defs/SubjectRef"},
        "title": {"type": "string"},
        "metadata": {"$ref": "#/$defs/Metadata"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "EvidenceDocument": {
      "type": "object",
      "required": ["externalRef", "source", "content"],
      "properties": {
        "externalRef": {"type": "string", "minLength": 1, "maxLength": 256, "description": "Caller's stable reference, unique within a subject."},
        "source": {"type": "string", "enum": ["interview", "review", "support", "sales", "survey", "job_posting", "social_post", "dataset"]},
        "title": {"type": "string", "maxLength": 512},
        "content": {"type": "string", "minLength": 1, "maxLength": 200000},
        "metadata": {"$ref": "#/$defs/Metadata"}
      }
    },
    "AddEvidenceRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey"],
      "description": "At least one document or analytical artifact is required. Artifacts follow contracts/analytical-artifact/v1/schema.json.",
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "documents": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/EvidenceDocument"}},
        "analyticalArtifacts": {"type": "array", "maxItems": 50, "items": {"type": "object"}}
      }
    },
    "EvidenceItemReceipt": {
      "type": "object",
      "required": ["documentId", "status"],
      "properties": {
        "externalRef": {"type": "string"},
        "artifactId": {"type": "string"},
        "reproducibilityKey": {"type": "string"},
        "documentId": {"type": "string"},
        "status": {"type": "string", "enum": ["CREATED", "UNCHANGED"]}
      }
    },
    "EvidenceReceipt": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "documents", "analyticalArtifacts"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/EvidenceItemReceipt"}},
        "analyticalArtifacts": {"type": "array", "items": {"$ref": "#/$defs/EvidenceItemReceipt"}}
      }
    },
    "StartAnalysisRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "label": {"type": "string", "maxLength": 256},
        "note": {"type": "string", "maxLength": 2000},
        "semanticAnalysisMode": {"type": "string", "enum": ["DISCOVERY", "DATASET_ANALYSIS", "RESEARCH_REVIEW"]}
      }
    },
    "AnalysisProvenance": {
      "type": "object",
      "description": "The run's execution and input snapshots, verbatim. A snapshot the run never recorded is omitted, never sent empty.",
      "properties": {
        "execution": {"type": "object"},
        "input": {"type": "object"}
      }
    },
    "AnalysisRun": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "analysisId", "status", "createdAt"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "analysisId": {"type": "string"},
        "status": {"type": "string", "enum": ["queued", "running", "completed", "failed"]},
        "error": {"type": "string"},
        "label": {"type": "string"},
        "note": {"type": "string"},
        "semanticAnalysisMode": {"type": "string"},
        "executionMode": {"type": "string", "enum": ["deterministic", "model_backed"]},
        "engine": {"$ref": "#/$defs/EngineBuild"},
        "executionFingerprint": {"type": "string"},
        "inputFingerprint": {"type": "string"},
        "provenance": {"$ref": "#/$defs/AnalysisProvenance"},
        "createdAt": {"type": "string", "format": "date-time"},
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "Observation": {
      "type": "object",
      "required": ["observationId", "documentId", "quote", "startOffset", "endOffset", "behavior"],
      "properties": {
        "observationId": {"type": "string"},
        "documentId": {"type": "string"},
        "externalRef": {"type": "string"},
        "quote": {"type": "string", "description": "Exact text of the source document between startOffset and endOffset (rune offsets)."},
        "startOffset": {"type": "integer"},
        "endOffset": {"type": "integer"},
        "behavior": {"type": "string"},
        "topic": {"type": "string"}
      }
    },
    "Finding": {
      "type": "object",
      "required": ["findingId", "kind", "title", "observationIds"],
      "properties": {
        "findingId": {"type": "string"},
        "kind": {"type": "string", "enum": ["repetition", "deviation"]},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "expectation": {"type": "string"},
        "observationIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "AnalysisResults": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "analysisId", "observations", "findings"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "analysisId": {"type": "string"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/Observation"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/Finding"}},
        "metrics": {"type": "object", "description": "The run's recorded evaluation metrics, verbatim."}
      }
    },
    "CreateResearchRunRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey", "question", "analysisId"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "analysisId": {"type": "string", "minLength": 1},
        "inputReferences": {"type": "array", "items": {"type": "string"}},
        "semanticAnalysisMode": {"type": "string", "enum": ["DISCOVERY", "DATASET_ANALYSIS", "RESEARCH_REVIEW"]}
      }
    },
    "AddedEvidenceLink": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "gapIds": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "AppendIterationRequest": {
      "type": "object",
      "required": ["contractVersion", "idempotencyKey", "analysisId"],
      "description": "Appends a new iteration evaluated on a completed analysis run. Earlier iterations are never modified.",
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "analysisId": {"type": "string", "minLength": 1},
        "question": {"type": "string", "maxLength": 2000},
        "addedEvidence": {"type": "array", "items": {"$ref": "#/$defs/AddedEvidenceLink"}}
      }
    },
    "ResearchResult": {
      "type": "object",
      "required": ["contractVersion", "subjectId", "researchRunId", "iterationId", "iterationSequence", "analysis", "artifact"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "subjectId": {"type": "string"},
        "researchRunId": {"type": "string"},
        "iterationId": {"type": "string"},
        "iterationSequence": {"type": "integer"},
        "analysis": {"$ref": "#/$defs/AnalysisRun"},
        "artifact": {"type": "object", "description": "The insight-lab.research-artifact v1 export of the latest iteration, verbatim. Its legacy analysisMode key means execution mode."}
      }
    },
    "ErrorBody": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "enum": ["INVALID_REQUEST", "UNSUPPORTED_CONTRACT_VERSION", "NOT_FOUND", "IDEMPOTENCY_CONFLICT", "IDENTITY_CONFLICT", "ANALYSIS_NOT_COMPLETED", "ANALYSIS_HAS_NO_HYPOTHESES", "MIXED_ANALYSIS_RUNS", "INTERNAL"]},
        "message": {"type": "string"}
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["contractVersion", "error"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "error": {"$ref": "#/$defs/ErrorBody"}
      }
    },
    "ScenarioBaseline": {
      "type": "object",
      "description": "Observed baseline all scenarios branch from. asOf is required.",
      "required": ["asOf", "description"],
      "properties": {
        "asOf": {"type": "string", "format": "date-time"},
        "description": {"type": "string"},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ScenarioHorizon": {
      "type": "object",
      "description": "Forecast horizon of a scenario; end must be after the baseline asOf.",
      "required": ["label", "end"],
      "properties": {
        "label": {"type": "string"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "TimeWindow": {
      "type": "object",
      "description": "Closed time window.",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "Assumption": {
      "type": "object",
      "description": "A typed assumption. Only OBSERVED_BASELINE may cite evidenceRefs as observed fact; other kinds cite sourceRefs.",
      "required": ["id", "statement", "kind", "asOf"],
      "properties": {
        "id": {"type": "string"},
        "statement": {"type": "string"},
        "kind": {"type": "string", "enum": ["OBSERVED_BASELINE", "EXOGENOUS_ASSUMPTION", "MODEL_ASSUMPTION", "HUMAN_ASSUMPTION", "POLICY_ASSUMPTION"]},
        "sourceRefs": {"type": "array", "items": {"type": "string"}},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}},
        "asOf": {"type": "string", "format": "date-time"},
        "validUntil": {"type": "string", "format": "date-time"}
      }
    },
    "ValueRange": {
      "type": "object",
      "description": "Optional numeric range for a RANGE expectation.",
      "required": [],
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"},
        "unit": {"type": "string"}
      }
    },
    "ScenarioExpectation": {
      "type": "object",
      "description": "Frozen, falsifiable statement about a future observation.",
      "required": ["id", "indicator", "statement", "observationWindow", "falsificationCondition", "provenance", "observedDataAvailableAtCreation"],
      "properties": {
        "id": {"type": "string"},
        "indicator": {"type": "string"},
        "statement": {"type": "string"},
        "direction": {"type": "string", "enum": ["INCREASE", "DECREASE", "NO_CHANGE", "RANGE"]},
        "range": {"$ref": "#/$defs/ValueRange"},
        "observationWindow": {"$ref": "#/$defs/TimeWindow"},
        "falsificationCondition": {"type": "string"},
        "provenance": {"type": "string", "description": "ExpectationBasis (PRIOR, LITERATURE, DOMAIN_KNOWLEDGE, MODEL_PROPOSED_POST_HOC, HUMAN_POST_HOC, DERIVED_FROM_PRIOR_RUN, OTHER, UNKNOWN). Post-hoc provenance is never treated as prior."},
        "observedDataAvailableAtCreation": {"type": "boolean"},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ScenarioProbability": {
      "type": "object",
      "description": "Caller-supplied probability with its basis and sources. The engine never generates one.",
      "required": ["value", "basis", "sourceRefs"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string"},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "Scenario": {
      "type": "object",
      "description": "One possible future branch. At least one expectation must be testable after the baseline.",
      "required": ["id", "title", "horizon", "assumptions", "expectations"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "horizon": {"$ref": "#/$defs/ScenarioHorizon"},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/Assumption"}},
        "mechanisms": {"type": "array", "items": {"type": "string"}},
        "expectations": {"type": "array", "items": {"$ref": "#/$defs/ScenarioExpectation"}},
        "disconfirmingObservations": {"type": "array", "items": {"type": "string"}},
        "affectedDimensions": {"type": "array", "items": {"type": "string"}},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}},
        "unresolvedGapIds": {"type": "array", "items": {"type": "string"}},
        "derivedFromHypothesisId": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "probability": {"$ref": "#/$defs/ScenarioProbability"}
      }
    },
    "ScenarioRelation": {
      "type": "object",
      "description": "Explicit relation between branches; scenarios need not be mutually exclusive.",
      "required": ["scenarioIds", "kind"],
      "properties": {
        "scenarioIds": {"type": "array", "items": {"type": "string"}},
        "kind": {"type": "string", "enum": ["MUTUALLY_EXCLUSIVE", "OVERLAPPING", "NESTED", "CONFLICTING"]},
        "note": {"type": "string"}
      }
    },
    "ScenarioSet": {
      "type": "object",
      "description": "Append-only scenario set version. Curating creates a new version.",
      "required": ["id", "researchRunId", "version", "question", "baseline", "nonExhaustive", "scenarios", "origin", "createdAt"],
      "properties": {
        "id": {"type": "string"},
        "researchRunId": {"type": "string"},
        "version": {"type": "integer"},
        "question": {"type": "string"},
        "baseline": {"$ref": "#/$defs/ScenarioBaseline"},
        "nonExhaustive": {"type": "boolean"},
        "sharedEvidenceRefs": {"type": "array", "items": {"type": "string"}},
        "scenarios": {"type": "array", "items": {"$ref": "#/$defs/Scenario"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/ScenarioRelation"}},
        "origin": {"type": "string", "enum": ["DETERMINISTIC_SCAFFOLD", "HUMAN", "MODEL", "IMPORTED"]},
        "fromIterationId": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "ScenarioSetDraft": {
      "type": "object",
      "description": "Scenario set submitted by a consumer; id, version and createdAt are assigned by the engine.",
      "required": ["question", "baseline", "nonExhaustive", "scenarios", "origin"],
      "properties": {
        "question": {"type": "string"},
        "baseline": {"$ref": "#/$defs/ScenarioBaseline"},
        "nonExhaustive": {"type": "boolean"},
        "sharedEvidenceRefs": {"type": "array", "items": {"type": "string"}},
        "scenarios": {"type": "array", "items": {"$ref": "#/$defs/Scenario"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/ScenarioRelation"}},
        "origin": {"type": "string", "enum": ["DETERMINISTIC_SCAFFOLD", "HUMAN", "MODEL", "IMPORTED"]},
        "fromIterationId": {"type": "string"}
      }
    },
    "IndicatorObservation": {
      "type": "object",
      "description": "A later observation for one expectation. CONSISTENT/CONTRADICTS require evidenceRef. Observations at or before the set was created cannot test it.",
      "required": ["expectationId", "outcome", "observedAt"],
      "properties": {
        "expectationId": {"type": "string"},
        "outcome": {"type": "string", "enum": ["CONSISTENT", "CONTRADICTS", "INCONCLUSIVE", "NOT_OBSERVED"]},
        "evidenceRef": {"type": "string"},
        "observedAt": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      }
    },
    "AssumptionCheck": {
      "type": "object",
      "description": "Whether later evidence kept an assumption. INVALIDATED requires evidenceRef.",
      "required": ["assumptionId", "result"],
      "properties": {
        "assumptionId": {"type": "string"},
        "result": {"type": "string", "enum": ["HOLDS", "INVALIDATED", "UNKNOWN"]},
        "evidenceRef": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "ScenarioState": {
      "type": "object",
      "description": "Evidence state of one scenario at one evaluation.",
      "required": ["scenarioId", "status", "lastEvaluatedAt"],
      "properties": {
        "scenarioId": {"type": "string"},
        "status": {"type": "string", "enum": ["UNTESTED", "CONSISTENT_SO_FAR", "WEAKENED", "CONTRADICTED", "INCONCLUSIVE"], "description": "Evidence state of a branch. Never a probability."},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "lastEvaluatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "FiredFalsification": {
      "type": "object",
      "description": "A falsification condition that fired on evidence.",
      "required": ["scenarioId", "expectationId", "condition", "evidenceRef"],
      "properties": {
        "scenarioId": {"type": "string"},
        "expectationId": {"type": "string"},
        "condition": {"type": "string"},
        "evidenceRef": {"type": "string"}
      }
    },
    "ScenarioStatusChange": {
      "type": "object",
      "description": "Status movement of one scenario.",
      "required": ["scenarioId", "from", "to"],
      "properties": {
        "scenarioId": {"type": "string"},
        "from": {"type": "string", "enum": ["UNTESTED", "CONSISTENT_SO_FAR", "WEAKENED", "CONTRADICTED", "INCONCLUSIVE"], "description": "Evidence state of a branch. Never a probability."},
        "to": {"type": "string", "enum": ["UNTESTED", "CONSISTENT_SO_FAR", "WEAKENED", "CONTRADICTED", "INCONCLUSIVE"], "description": "Evidence state of a branch. Never a probability."}
      }
    },
    "ScenarioDelta": {
      "type": "object",
      "description": "What new evidence changed. It ranks nothing and never names a most likely future.",
      "required": ["toEvaluationId"],
      "properties": {
        "fromEvaluationId": {"type": "string"},
        "toEvaluationId": {"type": "string"},
        "strengthened": {"type": "array", "items": {"$ref": "#/$defs/ScenarioStatusChange"}},
        "weakened": {"type": "array", "items": {"$ref": "#/$defs/ScenarioStatusChange"}},
        "contradicted": {"type": "array", "items": {"$ref": "#/$defs/ScenarioStatusChange"}},
        "unchanged": {"type": "array", "items": {"type": "string"}},
        "assumptionsInvalidated": {"type": "array", "items": {"type": "string"}},
        "falsificationsFired": {"type": "array", "items": {"$ref": "#/$defs/FiredFalsification"}},
        "newlyRequiredEvidence": {"type": "array", "items": {"type": "string"}},
        "explanation": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ScenarioEvaluation": {
      "type": "object",
      "description": "Append-only evaluation of one set version; carries forward earlier observations.",
      "required": ["id", "scenarioSetId", "setVersion", "researchRunId", "observations", "states", "delta", "evaluatedAt"],
      "properties": {
        "id": {"type": "string"},
        "scenarioSetId": {"type": "string"},
        "setVersion": {"type": "integer"},
        "researchRunId": {"type": "string"},
        "iterationId": {"type": "string"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/IndicatorObservation"}},
        "assumptionChecks": {"type": "array", "items": {"$ref": "#/$defs/AssumptionCheck"}},
        "states": {"type": "array", "items": {"$ref": "#/$defs/ScenarioState"}},
        "dataRequirements": {"type": "array", "items": {"type": "object", "description": "Scenario-specific DataRequirement, same shape as in the Research Artifact."}},
        "delta": {"$ref": "#/$defs/ScenarioDelta"},
        "evaluatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "CreateScenarioSetRequest": {
      "type": "object",
      "description": "Submit a curated scenario set as the next version.",
      "required": ["contractVersion", "idempotencyKey", "scenarioSet"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "scenarioSet": {"$ref": "#/$defs/ScenarioSetDraft"}
      }
    },
    "ScaffoldScenarioSetRequest": {
      "type": "object",
      "description": "Draft scenarios deterministically from an iteration's competing hypotheses. Baseline and horizon are required.",
      "required": ["contractVersion", "idempotencyKey", "baseline", "horizon"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "iterationId": {"type": "string"},
        "baseline": {"$ref": "#/$defs/ScenarioBaseline"},
        "horizon": {"$ref": "#/$defs/ScenarioHorizon"}
      }
    },
    "EvaluateScenariosRequest": {
      "type": "object",
      "description": "Evaluate a scenario set version against new observations.",
      "required": ["contractVersion", "idempotencyKey"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "iterationId": {"type": "string"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/IndicatorObservation"}},
        "assumptionChecks": {"type": "array", "items": {"$ref": "#/$defs/AssumptionCheck"}}
      }
    },
    "ScenarioSetResult": {
      "type": "object",
      "description": "A stored scenario set version.",
      "required": ["contractVersion", "researchRunId", "scenarioSet"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "researchRunId": {"type": "string"},
        "scenarioSet": {"$ref": "#/$defs/ScenarioSet"},
        "skipped": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ScenarioEvaluationResult": {
      "type": "object",
      "description": "A stored scenario evaluation.",
      "required": ["contractVersion", "researchRunId", "evaluation"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "researchRunId": {"type": "string"},
        "evaluation": {"$ref": "#/$defs/ScenarioEvaluation"}
      }
    },
    "ScenarioAnalysis": {
      "type": "object",
      "description": "Scenario history of a research run. Empty lists when none exist; scenarios are never synthesized.",
      "required": ["contractVersion", "researchRunId", "sets", "evaluations"],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "researchRunId": {"type": "string"},
        "currentSet": {"$ref": "#/$defs/ScenarioSet"},
        "currentEvaluation": {"$ref": "#/$defs/ScenarioEvaluation"},
        "sets": {"type": "array", "items": {"$ref": "#/$defs/ScenarioSet"}},
        "evaluations": {"type": "array", "items": {"$ref": "#/$defs/ScenarioEvaluation"}}
      }
    }
  }
}
